# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user ids allowed to use this bot.
# Polling stays disabled while this list is empty (default deny).
TELEGRAM_ALLOWED_USER_IDS=

# AIBAR/SillyTavern backend URL. Change it only in this file; the admin API cannot override it.
ST_BASE_URL=http://127.0.0.1:8001

# Dedicated AIBAR account used by the bot. This account owns the bot chats and pays model points.
ST_USER_HANDLE=
ST_USER_PASSWORD=

# Optional shared-model id. Empty uses the service account's active shared model, then the first enabled model.
AIBAR_MODEL_PROFILE_ID=

# Upper bound for max_tokens sent by the Telegram bot. Keeps oversized profiles from causing Bad Request.
AIBAR_MAX_COMPLETION_TOKENS=4096

# Polling and persistence.
POLL_TIMEOUT_SECONDS=25
DATA_DIR=./data

# Loopback admin API reached through the authenticated ST proxy. Set a unique random ADMIN_TOKEN (at least 24 characters).
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
ADMIN_TOKEN=
