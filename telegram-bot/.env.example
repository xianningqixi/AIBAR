# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user ids allowed to use this bot.
# Leave empty only if you are testing in a trusted private environment.
TELEGRAM_ALLOWED_USER_IDS=

# AIBAR/SillyTavern backend URL. In this repo dev setup this is usually 8001.
ST_BASE_URL=http://127.0.0.1:8001

# Optional model profile id from AIBAR settings. Empty means current active profile.
AIBAR_MODEL_PROFILE_ID=

# Upper bound for max_tokens sent by the Telegram bot. Keeps oversized profiles from causing Bad Request.
AIBAR_MAX_COMPLETION_TOKENS=4096

# Polling and persistence.
POLL_TIMEOUT_SECONDS=25
DATA_DIR=./data

# Local admin API used by the AIBAR settings page.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
ADMIN_TOKEN=
