# 本地 Discord 导入服务的环境变量示例。
# 复制为 .env 后按需修改；所有变量都有默认值，通常无需配置即可运行。
# 契约与所有权边界见 docs/local-discord-import-service.md，取值逻辑见 src/config.js。

# 服务监听地址。只允许 loopback（127.0.0.1 或 ::1），服务永不对外暴露。
AIBAR_DISCORD_SERVICE_HOST=127.0.0.1

# 服务监听端口，默认 4317（面板地址 http://127.0.0.1:4317/）。
AIBAR_DISCORD_SERVICE_PORT=4317

# CLI 客户端（npm run client）访问服务的完整地址，默认 http://127.0.0.1:4317。
AIBAR_DISCORD_SERVICE_URL=http://127.0.0.1:4317

# 任务/热门榜/心跳等状态文件的存放目录，默认为本目录下的 data/。
# AIBAR_DISCORD_SERVICE_DATA=./data

# CLI 的服务 token。默认从数据目录读取（服务首次启动时生成），一般不需要手动设置。
# AIBAR_DISCORD_SERVICE_TOKEN=

# 发布目标：正式 AIBAR 服务器的 Discord 发布入口（/hub?source=discord）。
# AIBAR_DISCORD_AIBAR_URL=https://172.86.116.166/aibar/#/hub?source=discord

# Codex 浏览器 worker 的可执行文件路径；默认自动探测，探测不到时回退到 PATH 里的 codex。
# AIBAR_DISCORD_CODEX_BIN=
